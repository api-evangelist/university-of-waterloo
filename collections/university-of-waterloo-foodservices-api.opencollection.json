{
  "opencollection": "1.0.0",
  "info": {
    "name": "Waterloo OpenData AcademicOrganizations FoodServices API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
