                "description": "WCMS object ID representing the Outlet"
              }
            ]
          },
          "docs": "Get specific food services Outlet data by Id"
        },
        {
          "info": {
            "name": "Get specific food services Outlet data by Outlet name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.data.uwaterloo.ca/v3/FoodServices/outlets/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name to filter Outlet by"
              }
            ]
          },
          "docs": "Get specific food services Outlet data by Outlet name"
        },
        {
