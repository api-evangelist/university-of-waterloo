          "docs": "Get all food service Outlet data"
        },
        {
          "info": {
            "name": "Get specific food services Outlet data by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.data.uwaterloo.ca/v3/FoodServices/outlets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
