{
  "opencollection": "1.0.0",
  "info": {
    "name": "Waterloo OpenData AcademicOrganizations ExamSchedules API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ExamSchedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns Exam Schedule data for the current Term",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.data.uwaterloo.ca/v3/ExamSchedules"
          },
          "docs": "Returns Exam Schedule data for the current Term"
        },
        {
          "info": {
            "name": "Returns Exam Schedule data for the requested Term",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.data.uwaterloo.ca/v3/ExamSchedules/:code",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path",
                "description": "Waterloo Term code"
              }
            ]
          },
          "docs": "Returns Exam Schedule data for the requested Term"
        }
      ]
    }
  ],
  "bundled": true
}